# Server only. Never use a NEXT_PUBLIC_ prefix for credentials.
APISH_KEY=
# Optional private-pilot live-search access token; configure with APISH_KEY.
PILOT_ACCESS_TOKEN=
# Apply migrations/001_observations.sql before using Supabase. Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local Node.js 24 SQLite fallback; not durable Vercel storage.
LACERELAY_DB_PATH=.data/observations.sqlite
# Only local test servers may opt into labelled fixture rows.
SHOW_TEST_FIXTURES=0
